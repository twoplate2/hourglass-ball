#!/bin/sh
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            case "$local_sha" in
                0000000000000000000000000000000000000000) continue ;;
            esac
            python tools/check_release_version.py --base "$remote_sha" --head "$local_sha" --check-title || exit 1
            ;;
    esac
done
