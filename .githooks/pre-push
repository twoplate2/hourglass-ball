#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# 外观审核及原始证据保留在本地；公开推送只检查APK应用、构建和单测。
tests="src/tools/test_release_version.py
src/tools/test_neck_geometry.py
src/tools/test_stream_aperture.py
src/tools/test_receiving_surface.py
src/tools/test_stream_sampling.py
src/tools/test_stream_contact_ceiling.py
src/tools/test_particle_continuity.py
src/tools/test_particle_material.py
src/tools/test_granular_material.py
src/tools/test_flare_occlusion.py
src/tools/test_splash_occlusion.py
src/tools/test_landing_spread.py
src/tools/test_splash_colours.py
src/tools/test_splash_tint_batch.py
src/tools/test_splash33_impulse.py
src/tools/test_short_grain.py
src/tools/test_grain_style.py
src/tools/test_ui_polish.py
src/tools/test_keep_awake.py
src/tools/test_physics_equiv.py"
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
        echo "Cannot push an untested ref: checkout it and run APK checks first."
        exit 1
    fi
    if [ "$checked" = 0 ]; then
        git diff --quiet HEAD -- main.py buildozer.spec src/app src/build .githooks .github src/tools/check_release_version.py src/tools/android_hook.py $tests || {
            echo "Release sources must match the pushed commit."
            exit 1
        }
        python -B - <<'PY'
import ast
import io
from pathlib import Path
from pyflakes.api import checkPath
from pyflakes.reporter import Reporter
files = [Path('main.py'), Path('src/tools/android_hook.py')] + sorted(Path('src/app').glob('*.py')) + sorted(Path('src/build').rglob('*.py'))
output, errors = io.StringIO(), io.StringIO()
reporter = Reporter(output, errors)
for file in files:
    ast.parse(file.read_text(encoding='utf-8'), filename=str(file))
    checkPath(str(file), reporter)
print(output.getvalue(), end='')
print(errors.getvalue(), end='')
if errors.getvalue() or 'undefined name' in output.getvalue():
    raise SystemExit(1)
print('APK_SOURCE_STATIC_OK', len(files))
PY
        for test in $tests; do
            python -B "$test" || exit 1
        done
        checked=1
    fi
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            python src/tools/check_release_version.py --base "$remote_sha" --head "$local_sha" --check-title || exit 1
            ;;
    esac
done
