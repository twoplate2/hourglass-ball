#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
        echo "Cannot push an untested ref: checkout it and run full checks first."
        exit 1
    fi
    if [ "$checked" = 0 ]; then
        git diff --quiet HEAD -- main.py buildozer.spec src .githooks .github design/checks/rules || {
            echo "Release sources must match the pushed commit."
            exit 1
        }
        python -B src/tools/release_decision.py --committed || exit 1
        python -B src/tools/test_material_release.py || exit 1
        python -B src/tools/check_flow_release.py || exit 1
        python -B src/tools/test_neck_geometry.py || exit 1
        python -B src/tools/test_stream_aperture.py || exit 1
        python -B src/tools/test_receiving_surface.py || exit 1
        python -B src/tools/test_release_decision.py || exit 1
        python -B src/tools/test_pixel_flow_review.py || exit 1
        python -B src/tools/test_stream_review_metrics.py || exit 1
        python -B src/tools/test_flow_release.py || exit 1
        python -B src/tools/test_particle_continuity.py || exit 1
        python -B src/tools/test_particle_release.py || exit 1
        python -B src/tools/test_stream_motion_shape.py || exit 1
        python -B src/tools/test_motion_shape_release.py || exit 1
        python -B src/tools/test_short_grain.py || exit 1
        python -B src/tools/test_short_grain_release.py || exit 1
        python -B src/tools/test_grain_style.py || exit 1
        python -B src/tools/test_ui_polish.py || exit 1
        python -B src/tools/test_keep_awake.py || exit 1
        python -B src/tools/verify_keep_awake_runtime.py || exit 1
        python -B src/tools/run_regression.py --profile core || exit 1
        checked=1
    fi
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            python src/tools/check_release_version.py --base "$remote_sha" --head "$local_sha" --check-title || exit 1
            ;;
    esac
done
