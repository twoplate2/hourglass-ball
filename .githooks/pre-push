#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
        echo "Cannot push an untested ref: checkout it and run full checks first."
        exit 1
    fi
    if [ "$checked" = 0 ]; then
        python -B src/tools/check_visual_review.py --review _temp/visual-review/latest.json || exit 1
        checked=1
    fi
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            python src/tools/check_release_version.py --base "$remote_sha" --head "$local_sha" --check-title || exit 1
            ;;
    esac
done
