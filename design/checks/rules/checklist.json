{
  "schema": 1,
  "visual_case_file": "design/checks/rules/sand-flow-cases.json",
  "core": ["layout", "version", "gate", "static", "design-pages"],
  "tests": [
    {"id": "layout", "command": ["src/tools/test_repository_layout.py"], "timeout": 60, "unittest_min": 10},
    {"id": "version", "command": ["src/tools/test_release_version.py"], "timeout": 60, "unittest_min": 5},
    {"id": "gate", "command": ["src/tools/test_regression_gate.py"], "timeout": 60, "unittest_min": 23},
    {"id": "static", "command": ["src/tools/run_regression.py", "--static-check"], "timeout": 60, "markers": ["STATIC_DONE"]},
    {"id": "design-pages", "command": ["src/tools/check_design_pages.py", "--out", "{run}/design-pages.json"], "timeout": 60, "markers": ["HTML_DONE", "failures=0"]},
    {"id": "particle-identity", "command": ["src/tools/check_flow_release.py"], "timeout": 420, "markers": ["FLOW_RELEASE_OK"]},
    {"id": "particle-continuity-tests", "command": ["src/tools/test_particle_continuity.py"], "timeout": 60, "unittest_min": 20},
    {"id": "particle-material-tests", "command": ["src/tools/test_particle_material.py"], "timeout": 60, "unittest_min": 2},
    {"id": "flare-occlusion-tests", "command": ["src/tools/test_flare_occlusion.py"], "timeout": 60, "unittest_min": 5},
    {"id": "splash-occlusion-tests", "command": ["src/tools/test_splash_occlusion.py"], "timeout": 60, "unittest_min": 4},
    {"id": "landing-spread-tests", "command": ["src/tools/test_landing_spread.py"], "timeout": 60, "unittest_min": 8},
    {"id": "splash-colour-tests", "command": ["src/tools/test_splash_colours.py"], "timeout": 60, "unittest_min": 10},
    {"id": "splash-tint-batch-tests", "command": ["src/tools/test_splash_tint_batch.py"], "timeout": 60, "unittest_min": 13},
    {"id": "splash33-impulse-tests", "command": ["src/tools/test_splash33_impulse.py"], "timeout": 60, "unittest_min": 5},
    {"id": "particle-release-tests", "command": ["src/tools/test_particle_release.py"], "timeout": 60, "unittest_min": 24},
    {"id": "material-release-tests", "command": ["src/tools/test_material_release.py"], "timeout": 60, "unittest_min": 9},
    {"id": "short-grain-release-tests", "command": ["src/tools/test_short_grain_release.py"], "timeout": 60, "unittest_min": 12},
    {"id": "short-grain-tests", "command": ["src/tools/test_short_grain.py"], "timeout": 60, "unittest_min": 10},
    {"id": "motion-shape-tests", "command": ["src/tools/test_stream_motion_shape.py"], "timeout": 60, "unittest_min": 18},
    {"id": "motion-shape-release-tests", "command": ["src/tools/test_motion_shape_release.py"], "timeout": 60, "unittest_min": 23},
    {"id": "keep-awake", "command": ["src/tools/test_keep_awake.py"], "timeout": 60, "unittest_min": 12},
    {"id": "ui-polish", "command": ["src/tools/test_ui_polish.py"], "timeout": 60, "unittest_min": 12},
    {"id": "grain-style", "command": ["src/tools/test_grain_style.py"], "timeout": 60, "unittest_min": 8},
    {"id": "keep-awake-runtime", "command": ["src/tools/verify_keep_awake_runtime.py"], "timeout": 120, "markers": ["KEEP_AWAKE_RUNTIME_OK"]},
    {"id": "physics", "command": ["src/tools/test_physics_equiv.py"], "timeout": 120, "markers": ["PASS: 标量版与向量化版逐位一致", "判别性:"]},
    {"id": "packing", "command": ["src/tools/test_pack_equiv.py"], "timeout": 120, "markers": ["PASS: 向量化打包与逐颗粒打包字节完全相同"]},
    {"id": "stream-drawing", "command": ["src/tools/test_stream_rendering.py"], "timeout": 60, "unittest_min": 10},
    {"id": "finish", "command": ["src/tools/verify_sand_finish.py", "--out", "{run}/finish"], "timeout": 300, "markers": ["SUMMARY cases=15 failures=0"]},
    {"id": "application", "command": ["src/tools/verify_hourglass.py"], "timeout": 240, "markers": ["All checks passed", "all four benchmark periods completed", "natural completion announces exactly once"], "pass_min": 100},
    {"id": "application-cancel", "command": ["src/tools/verify_hourglass.py", "--quick"], "timeout": 180, "markers": ["All checks passed", "UI cancellation finishes benchmark", "UI cancellation restores animation state"], "pass_min": 100},
    {"id": "menu-levels", "command": ["src/tools/verify_dev_levels.py"], "timeout": 120, "markers": ["DEV_LEVELS_DONE", "failures=0"]},
    {"id": "grain-levels", "command": ["src/tools/verify_grain_levels.py"], "timeout": 120, "markers": ["GRAIN_LEVELS_DONE pairs=5 failures=0"]},
    {"id": "geometry", "command": ["src/tools/_probe_geom_invariants.py"], "timeout": 120, "markers": ["GEOMETRY_DONE cases=14 failures=0"]},
    {"id": "rendering", "command": ["src/tools/_render_golden.py", "--check", "--label", "{label}"], "timeout": 900, "markers": ["==> 渲染 逐图一致", "RENDER_DONE arms=7"]},
    {"id": "splash", "command": ["src/tools/_splash_golden.py", "--check"], "timeout": 300, "markers": ["==> 金标准轨迹 逐位一致"]},
    {"id": "neck-geometry", "command": ["src/tools/test_neck_geometry.py"], "timeout": 60, "unittest_min": 7},
    {"id": "stream-aperture", "command": ["src/tools/test_stream_aperture.py"], "timeout": 60, "unittest_min": 4},
    {"id": "receiving-surface", "command": ["src/tools/test_receiving_surface.py"], "timeout": 60, "unittest_min": 4},
    {"id": "current-decision", "command": ["src/tools/test_release_decision.py"], "timeout": 60, "unittest_min": 7},
    {"id": "stream-review", "command": ["src/tools/test_stream_review_metrics.py"], "timeout": 60, "unittest_min": 8},
    {"id": "flow-release", "command": ["src/tools/test_flow_release.py"], "timeout": 60, "unittest_min": 45},
    {"id": "pixel-flow", "command": ["src/tools/test_pixel_flow_review.py"], "timeout": 60, "unittest_min": 4}
  ],
  "rules": [
    {"paths": ["main.py", "src/app/**", "app/**", "app_version.py", "frame_benchmark.py"], "tests": "all", "reason": "运行代码互相影响，不能只测改动处"},
    {"paths": ["src/tools/**", "tools/**", "design/checks/**", ".githooks/**", ".github/**"], "tests": "all", "reason": "量具或发布流程变化，需要完整检查防止漏测"},
    {"paths": ["buildozer.spec", "ui/**", "sounds/**"], "tests": "all", "reason": "资源、布局、音频与打包需要关联验证"},
    {"paths": ["README.md", "AGENTS.md", "CLAUDE.md", ".gitignore", ".gitattributes", "docs/**", "design/**"], "tests": [], "reason": "资料变化仅加基础检查；发布仍须完整检查"}
  ],
  "manual": [
    {"id": "visual", "description": "前后画面对照及未改区域、全部配色档位、多尺寸"},
    {"id": "audio", "description": "MuMu 实际听音及开始暂停恢复重置完成"},
    {"id": "performance", "description": "同环境前后重复测量，比较 1% low 和最慢帧"}
  ]
}
